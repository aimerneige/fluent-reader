{
  "name": "fluent-reader",
  "version": "1.2.0",
  "description": "Modern desktop RSS reader",
  "main": "./dist/electron.js",
  "scripts": {
    "build": "webpack --config ./webpack.config.js",
    "electron": "electron ./dist/electron.js",
    "start": "npm run build && npm run electron",
    "format": "prettier --write .",
    "package-win": "electron-builder -w appx:x64 && electron-builder -w appx:ia32 && electron-builder -w appx:arm64",
    "package-win-ci": "electron-builder -w --x64 -p never && electron-builder -w --ia32 -p never",
    "package-mac": "electron-builder --mac --x64 -p never",
    "package-mas": "bash build/resignAndPackage.sh",
    "package-linux": "electron-builder --linux --x64 -p never"
  },
  "keywords": [],
  "author": "Haoyuan Liu",
  "contributors": [
    "Haoyuan Liu",
    "Aimer Neige <i@aimer.moe>"
  ],
  "license": "BSD-3-Clause",
  "repository": "github:yang991178/fluent-reader",
  "devDependencies": {
    "@fluentui/react": "^8.125.5",
    "@types/marked": "^5.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-redux": "^7.1.9",
    "electron": "^40.6.1",
    "electron-builder": "^26.0.0",
    "electron-store": "^11.0.2",
    "electron-window-state": "^5.0.3",
    "font-list": "^2.0.2",
    "html-webpack-plugin": "^5.5.3",
    "js-md5": "^0.8.3",
    "marked": "^17.0.3",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "prettier": "^3.8.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl-universal": "^2.13.4",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.1.1",
    "rss-parser": "^3.13.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "dexie": "^4.3.0"
  }
}
